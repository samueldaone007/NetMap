# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=netmap
DB_USER=netmap
DB_PASSWORD=netmap
DB_HOST=127.0.0.1
# compose.yaml publishes PostgreSQL on 5433 to avoid clashing with a local install.
DB_PORT=5433

# Uploads are capped at 10 MB.
NETMAP_MAX_UPLOAD_MB=10
